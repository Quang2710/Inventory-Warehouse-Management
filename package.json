{
  "name": "inventory-warehouse-management",
  "version": "0.1.0",
  "description": "Frontend quản lý tồn kho & kho hàng (Angular + MSW mock backend)",
  "scripts": {
    "ng": "node node_modules/@angular/cli/bin/ng.js",
    "start": "node node_modules/@angular/cli/bin/ng.js serve",
    "start:api": "node node_modules/@angular/cli/bin/ng.js serve --configuration dev-api",
    "build": "node node_modules/@angular/cli/bin/ng.js build",
    "build:demo": "node node_modules/@angular/cli/bin/ng.js build --configuration production,demo",
    "watch": "node node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
    "test": "node node_modules/@angular/cli/bin/ng.js test",
    "test:ci": "node node_modules/@angular/cli/bin/ng.js test --no-watch",
    "e2e": "node node_modules/@playwright/test/cli.js test",
    "lint": "node node_modules/@angular/cli/bin/ng.js lint",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "api:gen": "node node_modules/openapi-typescript/bin/cli.js openapi.yaml -o src/app/core/api/schema.ts --root-types --root-types-no-schema-prefix && node node_modules/prettier/bin/prettier.cjs --write src/app/core/api/schema.ts",
    "msw:init": "node node_modules/msw/cli/index.js init public --save",
    "prepare": "node node_modules/husky/bin.js"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "~21.2.0",
    "@ngrx/signals": "^21.1.1",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "@zxing/ngx-scanner": "^21.0.0",
    "echarts": "^6.1.0",
    "ngx-echarts": "^21.0.0",
    "pdfmake": "^0.2.23",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^9.9.0",
    "@mswjs/data": "^0.16.2",
    "@playwright/test": "^1.64.1",
    "@types/pdfmake": "^0.2.12",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.4.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
